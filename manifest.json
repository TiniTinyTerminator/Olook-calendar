{
  "schemaVersion": 1,
  "id": "ttt.olook-calendar",
  "name": "Olook Calendar",
  "version": "1.0.0",
  "author": "TiniTinyTerminator",
  "license": "MIT",
  "description": "The clock and the calendar in one: date and time in the bar, a month marked with the days you have something on, and the agenda behind it. Replaces Omarchy's clock.",
  "kinds": [
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Olook Clock & Calendar",
    "description": "Date and time, a marked month, and what is coming up.",
    "category": "Time",
    "aliases": [
      "calendar",
      "clock",
      "agenda",
      "appointments",
      "olook-calendar"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 300,
      "showNextInBar": true,
      "daysAhead": 2,
      "format": "dddd HH:mm"
    },
    "schema": [
      {
        "key": "format",
        "type": "string",
        "label": "Label format",
        "defaultValue": "dddd HH:mm",
        "description": "Qt date format, as the Omarchy clock uses: dddd HH:mm, d MMMM yyyy, HH:mm."
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Re-read the calendar every (seconds)",
        "min": 60,
        "max": 3600,
        "step": 60,
        "defaultValue": 300
      },
      {
        "key": "showNextInBar",
        "type": "boolean",
        "label": "Show the next appointment beside the icon",
        "defaultValue": true
      },
      {
        "key": "daysAhead",
        "type": "integer",
        "label": "Days of agenda in the panel",
        "min": 1,
        "max": 7,
        "step": 1,
        "defaultValue": 2
      }
    ]
  }
}
